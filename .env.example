# Copier ce fichier en .env et remplir les valeurs (.env n'est pas commité).

# Base de données MySQL
# Avec docker compose, seul l'utilisateur root est créé : garder DB_USERNAME=root.
DB_USERNAME=root
DB_PASSWORD=
# Hors Docker uniquement (par défaut : jdbc:mysql://localhost:3306/sndp…)
# DB_URL=jdbc:mysql://localhost:3306/sndp?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Clé de signature des JWT : au moins 32 caractères aléatoires
JWT_SECRET=

# Premier administrateur, créé au démarrage si la base ne contient aucun utilisateur
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Adresse du frontend, utilisée dans le lien du mail « mot de passe oublié »
FRONTEND_URL=http://localhost:4200

# Serveur SMTP (Mailtrap par défaut en développement)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
